{
    "name": "mgtr95/artlar-installer",
    "description": "Artlar application installer (artlar new).",
    "keywords": [
        "artlar",
        "laravel",
        "installer"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "mgtr95"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/prompts": "^0.3.0",
        "symfony/console": "^6.2|^7.0|^8.0",
        "symfony/process": "^6.2|^7.0|^8.0"
    },
    "bin": [
        "bin/artlar"
    ],
    "autoload": {
        "psr-4": {
            "Artlar\\Installer\\Console\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
